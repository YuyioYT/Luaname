// Noise function

vec3 mod289(vec3 x) {
	return x - floor(x * (1.0 / 289.0)) * 289.0;
}

vec2 mod289(vec2 x) {
	return x - floor(x * (1.0 / 289.0)) * 289.0;
}

vec3 permute(vec3 x) {
	return mod289(((x*34.0)+1.0)*x);
}

float snoise(vec2 v)
{
	const vec4 C = vec4(0.211324865405187,  // (3.0-sqrt(3.0))/6.0
		0.366025403784439,  // 0.5*(sqrt(3.0)-1.0)
		-0.577350269189626,  // -1.0 + 2.0 * C.x
		0.024390243902439); // 1.0 / 41.0
	// First corner
	vec2 i  = floor(v + dot(v, C.yy) );
	vec2 x0 = v -   i + dot(i, C.xx);

	// Other corners
	vec2 i1;
	//i1.x = step( x0.y, x0.x ); // x0.x > x0.y ? 1.0 : 0.0
	//i1.y = 1.0 - i1.x;
	i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
	// x0 = x0 - 0.0 + 0.0 * C.xx ;
	// x1 = x0 - i1 + 1.0 * C.xx ;
	// x2 = x0 - 1.0 + 2.0 * C.xx ;
	vec4 x12 = x0.xyxy + C.xxzz;
	x12.xy -= i1;

	// Permutations
	i = mod289(i); // Avoid truncation effects in permutation
	vec3 p = permute( permute( i.y + vec3(0.0, i1.y, 1.0 ))
		+ i.x + vec3(0.0, i1.x, 1.0 ));

	vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
	m = m*m ;
	m = m*m ;

	// Gradients: 41 points uniformly over a line, mapped onto a diamond.
	// The ring size 17*17 = 289 is close to a multiple of 41 (41*7 = 287)

	vec3 x = 2.0 * fract(p * C.www) - 1.0;
	vec3 h = abs(x) - 0.5;
	vec3 ox = floor(x + 0.5);
	vec3 a0 = x - ox;

	// Normalise gradients implicitly by scaling m
	// Approximation of: m *= inversesqrt( a0*a0 + h*h );
	m *= 1.79284291400159 - 0.85373472095314 * ( a0*a0 + h*h );

	// Compute final noise value at P
	vec3 g;
	g.x  = a0.x  * x0.x  + h.x  * x0.y;
	g.yz = a0.yz * x12.xz + h.yz * x12.yw;
	return 130.0 * dot(m, g);
}

//----------

vec2 flowUV(vec2 uv)
{
	// distort uv basic test
	//uv.x += 0.1 * cos(9. * uv.y);

	vec2 offset = vec2( snoise(4. * cos(1.3 * uv + 0.01 * iTime)), snoise(3. * sin(1.5 * uv.yx + 0.01 * iTime) ) );
	offset = offset * 2.0 - 1.0;
	uv += 0.05 * offset;

	return uv;
}

#define LINE_WIDTH 0.0

float plot(float v, float pct){
	return  smoothstep( pct-LINE_WIDTH, pct, v) -
	smoothstep( pct, pct+LINE_WIDTH, v);
}

#define UV_GRID_STEPS 10.0
vec3 uvGrid(vec2 uv)
{
	float size = 1.0 / UV_GRID_STEPS;
	vec2 r = uv - floor(uv / size) * size;
	r *= UV_GRID_STEPS;		// vale in each grid is 0 - 1

	// 0 - 1 color gradient
	//vec3 col = vec3(r, 0.0);

	// grid line
	//vec3 col = vec3( smoothstep(r, vec2(0.48), vec2(0.52) ), 0.0);
	//vec3 col = vec3( plot(r.x, 0.5), plot(r.y, 0.5), 0.0);
	vec3 col = vec3( max(plot(r.x, 0.5), plot(r.y, 0.5)) );

	return col;
}

void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
	// Normalized pixel coordinates (from 0 to 1)
	vec2 uv = fragCoord/iResolution.xy;
	uv.y *= iResolution.y / iResolution.x;

	//vec3 col = vec3( snoise(uv * 5. + iTime), 0., 0.);

	uv = flowUV(uv);

	// uv grid pattern
	// or replace with texture image sampling

	//vec3 col = uvGrid(uv);
	vec3 col = texture(iChannel0, uv).rgb;
	col += uvGrid(uv);

	// // Time varying pixel color
	// vec3 col = 0.5 + 0.5*cos(iTime+uv.xyx+vec3(0,2,4));

	// Output to screen
	fragColor = vec4(col,texture(iChannel0, uv).a);
}

void main() {
	mainImage(gl_FragColor, openfl_TextureCoordv*openfl_TextureSize);
}
